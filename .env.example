# Copy to .env and edit
DB_TYPE=sqlite
SQLITE_PATH=monitoring.db

DB_USER=IFS_MONITOR
DB_PASSWORD=change_me
DB_DSN=your-db-host:1521/IFSCOESALES
POOL_MAX=4
QUERY_TIMEOUT_MS=15000
CACHE_TTL_SEC=20

# Schema holding IFS objects
IFS_OWNER=IFSAPP
# Index B-level threshold (>= this value is flagged)
BLEVEL_THRESHOLD=3
# IFS tables for message / background job status (VERIFY in your version, see README)
APPMSG_TABLE=IFSAPP.APPLICATION_MESSAGE_TAB
APPMSG_STATE_COL=STATE
BGJOB_TABLE=IFSAPP.TRANSACTION_SYS_LOCAL_TAB
BGJOB_STATE_COL=STATE

# Dashboard login (leave DASH_USER empty to disable)
DASH_USER=admin
DASH_PASS=change_me_too
HOST=0.0.0.0
PORT=8080

# =====================================================================
# EMAIL + SMS ALERTS  (everything below can be changed without touching code; restart the app after editing)
# Both channels are OFF until you set *_ENABLED=true. Alerts always appear in the dashboard bell regardless.
# =====================================================================
ENV_NAME=IFSCOESALES
# Optional: link added to emails, e.g. http://your-server:8080
DASHBOARD_URL=

# ---- Email (any SMTP server: Office 365, Gmail app password, company relay) ----
ALERT_EMAIL_ENABLED=false
# You and your sir - comma separated, each person gets their own email
ALERT_EMAIL_TO=your.name@example.com,sir.name@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# starttls (port 587) | ssl (port 465) | none
SMTP_SECURITY=starttls
SMTP_USER=alerts@example.com
SMTP_PASS=change_me
ALERT_EMAIL_FROM=alerts@example.com

# ---- SMS ----
ALERT_SMS_ENABLED=false
# International format with country code, comma separated
ALERT_SMS_TO=+91XXXXXXXXXX,+91YYYYYYYYYY
# twilio  |  webhook (any HTTP SMS gateway: POST {"to": "...", "message": "..."})
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Use EITHER a Twilio number OR a Messaging Service SID
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=

# ---- Which alert types are sent: always | critical | never  (defaults shown = the agreed table) ----
#   critical = only when the alert severity is CRITICAL;  never = dashboard only
# Alert types: failed_job, failed_message, critical_server, critical_database, api_failure, open_critical_alert
ALERT_EMAIL_RULES=failed_job=critical,failed_message=critical,critical_server=always,api_failure=always,open_critical_alert=always
ALERT_SMS_RULES=failed_job=critical,failed_message=critical,critical_server=always,api_failure=always,open_critical_alert=always

# ---- Anti-spam ----
# Same alert type + same server/API/job name: at most one email/SMS per this many minutes
ALERT_COOLDOWN_MINUTES=60
# Events older than this are shown in the dashboard but not emailed/texted
ALERT_MAX_AGE_HOURS=24
# More new alerts than this in one check are sent as ONE summary email/SMS
ALERT_MAX_INDIVIDUAL=5
# A failed send (SMTP/SMS gateway down) is retried this many times, waiting this many minutes between tries
ALERT_MAX_ATTEMPTS=4
ALERT_RETRY_MINUTES=5
# How often the app checks the database for new events (seconds) - works even with no browser open
ALERT_SCAN_SECONDS=30

# ---- Critical-server e-mail (one e-mail listing every server whose health is CRITICAL) ----
SERVER_CRITICAL_ALERT_ENABLED=true
# Server statuses treated as critical (comma separated)
SERVER_CRITICAL_STATUSES=CRITICAL,DOWN,FAILED,UNHEALTHY
# A server that STAYS critical is e-mailed again after this many minutes (0 = only once until it recovers)
SERVER_CRITICAL_REPEAT_MINUTES=60

# Optional: sender display name shown in the inbox (the address is ALERT_EMAIL_FROM, which must be the SMTP_USER Gmail)
# ALERT_EMAIL_FROM_NAME=Zenova Matrix

# ---- Deployment (run_server.py) ----
# 0.0.0.0 = reachable from other computers on the network; 127.0.0.1 = this computer only
HOST=0.0.0.0
PORT=8080
THREADS=8
# Login for the dashboard (HTTP Basic). With app_local / run_server it is enabled only when BOTH are set.
# DASH_USER=admin
# DASH_PASS=choose_a_strong_password
